# StreamTeX Ansible Inventory — Example
# Copy this file to inventory.ini and fill in your values.
#
# Prerequisites:
#   - A GCP Compute Engine VM (e.g. e2-micro with Ubuntu 22.04)
#   - SSH key configured: ssh-keygen -t ed25519 -C "your-email@example.com"
#   - Public key added to GCP > Compute Engine > Metadata > SSH Keys

[webserver]
# Replace with your VM's external IP, username, and SSH key path
YOUR_VM_EXTERNAL_IP ansible_user=YOUR_USERNAME ansible_ssh_private_key_file=~/.ssh/id_ed25519

[webserver:vars]
ansible_become=True
ansible_python_interpreter=/usr/bin/python3
